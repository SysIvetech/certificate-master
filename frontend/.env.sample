# ivetech 통합 인증 서비스 (백엔드 AUTH_ENABLED 와 함께 켜고 끔)
NEXT_PUBLIC_AUTH_ENABLED=false
# dev: https://dev-auth.ivetech.co.kr / prod: https://auth.ivetech.co.kr
NEXT_PUBLIC_AUTH_API_URL=

# /api/* rewrite 대상 백엔드 주소 (빌드/dev 시점 필수, 비어 있으면 빌드 실패)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=your-naver-verification-code
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX